# Copy to server/.env (gitignored). Never commit a real key.
# IonQ API key — the documented variable qiskit-ionq reads. Get one at https://cloud.ionq.com
IONQ_API_KEY=
# Optional: which IonQ noise model the "IonQ simulator (noise model)" backend uses. forte-1 is the default.
IONQ_NOISE_MODEL=forte-1
# Optional: seconds to wait for an IonQ job before falling back to the local simulator (default 90)
IONQ_TIMEOUT_SECONDS=90
